#: app.py:124 app.py:156
msgid "Enter your email and password."
msgstr "Gib deine E-Mail-Adresse und dein Passwort ein."

#: app.py:126
msgid "Your password must contain at least 8 characters."
msgstr "Dein Passwort muss mindestens 8 Zeichen enthalten."

#: app.py:128
msgid "The passwords do not match."
msgstr "Die Passwörter stimmen nicht überein."

#: app.py:137
msgid "We could not create the account. Check the details and try again."
msgstr "Das Konto konnte nicht erstellt werden. Prüfe deine Angaben und versuche es erneut."

#: app.py:142 app.py:168 app.py:317
msgid "Check your email to confirm your account, then sign in."
msgstr "Bestätige dein Konto über den Link in deiner E-Mail und melde dich anschließend an."

#: app.py:165
msgid "Email or password is incorrect."
msgstr "E-Mail-Adresse oder Passwort ist falsch."

#: app.py:183
msgid "You have signed out."
msgstr "Du hast dich abgemeldet."

#: app.py:209
msgid "Enter a product name up to 200 characters long."
msgstr "Gib einen Produktnamen mit höchstens 200 Zeichen ein."

#: app.py:216
msgid "Enter a valid price."
msgstr "Gib einen gültigen Preis ein."

#: app.py:220
msgid "Enter a price with up to two decimal places."
msgstr "Gib einen Preis mit höchstens zwei Nachkommastellen ein."

#: app.py:229
msgid "Choose a priority from 1 to 3."
msgstr "Wähle eine Priorität von 1 bis 3."

#: app.py:233
msgid "Enter a valid Amazon Spain product link."
msgstr "Gib einen gültigen Produktlink von Amazon Spanien ein."

#: app.py:248
msgid "Product added to your wishlist."
msgstr "Produkt zur Wunschliste hinzugefügt."

#: app.py:270
msgid "Product marked as bought."
msgstr "Produkt als gekauft markiert."

#: app.py:284
msgid "Product removed from your wishlist."
msgstr "Produkt von der Wunschliste entfernt."

#: app.py:344
msgid "Your session has expired. Please sign in again."
msgstr "Deine Sitzung ist abgelaufen. Bitte melde dich erneut an."

