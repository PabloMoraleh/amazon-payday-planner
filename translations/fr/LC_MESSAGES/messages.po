#: app.py:124 app.py:156
msgid "Enter your email and password."
msgstr "Saisissez votre adresse e-mail et votre mot de passe."

#: app.py:126
msgid "Your password must contain at least 8 characters."
msgstr "Votre mot de passe doit contenir au moins 8 caractères."

#: app.py:128
msgid "The passwords do not match."
msgstr "Les mots de passe ne correspondent pas."

#: app.py:137
msgid "We could not create the account. Check the details and try again."
msgstr "Nous n’avons pas pu créer le compte. Vérifiez les informations et réessayez."

#: app.py:142 app.py:168 app.py:317
msgid "Check your email to confirm your account, then sign in."
msgstr "Consultez votre e-mail pour confirmer votre compte, puis connectez-vous."

#: app.py:165
msgid "Email or password is incorrect."
msgstr "L’adresse e-mail ou le mot de passe est incorrect."

#: app.py:183
msgid "You have signed out."
msgstr "Vous êtes déconnecté."

#: app.py:209
msgid "Enter a product name up to 200 characters long."
msgstr "Saisissez un nom de produit de 200 caractères maximum."

#: app.py:216
msgid "Enter a valid price."
msgstr "Saisissez un prix valide."

#: app.py:220
msgid "Enter a price with up to two decimal places."
msgstr "Saisissez un prix avec deux décimales au maximum."

#: app.py:229
msgid "Choose a priority from 1 to 3."
msgstr "Choisissez une priorité de 1 à 3."

#: app.py:233
msgid "Enter a valid Amazon Spain product link."
msgstr "Saisissez un lien valide vers un produit Amazon Espagne."

#: app.py:248
msgid "Product added to your wishlist."
msgstr "Produit ajouté à votre liste d’envies."

#: app.py:270
msgid "Product marked as bought."
msgstr "Produit marqué comme acheté."

#: app.py:284
msgid "Product removed from your wishlist."
msgstr "Produit retiré de votre liste d’envies."

#: app.py:344
msgid "Your session has expired. Please sign in again."
msgstr "Votre session a expiré. Veuillez vous reconnecter."

