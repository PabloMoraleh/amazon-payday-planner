#: app.py:124 app.py:156
msgid "Enter your email and password."
msgstr "Introduce tu correo electrónico y tu contraseña."

#: app.py:126
msgid "Your password must contain at least 8 characters."
msgstr "La contraseña debe tener al menos 8 caracteres."

#: app.py:128
msgid "The passwords do not match."
msgstr "Las contraseñas no coinciden."

#: app.py:137
msgid "We could not create the account. Check the details and try again."
msgstr "No se pudo crear la cuenta. Revisa los datos e inténtalo de nuevo."

#: app.py:142 app.py:168 app.py:317
msgid "Check your email to confirm your account, then sign in."
msgstr "Revisa tu correo para confirmar la cuenta y después inicia sesión."

#: app.py:165
msgid "Email or password is incorrect."
msgstr "El correo o la contraseña no son correctos."

#: app.py:183
msgid "You have signed out."
msgstr "Has cerrado sesión."

#: app.py:209
msgid "Enter a product name up to 200 characters long."
msgstr "Introduce un nombre de producto de hasta 200 caracteres."

#: app.py:216
msgid "Enter a valid price."
msgstr "Introduce un precio válido."

#: app.py:220
msgid "Enter a price with up to two decimal places."
msgstr "Introduce un precio con un máximo de dos decimales."

#: app.py:229
msgid "Choose a priority from 1 to 3."
msgstr "Elige una prioridad del 1 al 3."

#: app.py:233
msgid "Enter a valid Amazon Spain product link."
msgstr "Introduce un enlace válido de un producto de Amazon España."

#: app.py:248
msgid "Product added to your wishlist."
msgstr "Producto añadido a tu lista de deseos."

#: app.py:270
msgid "Product marked as bought."
msgstr "Producto marcado como comprado."

#: app.py:284
msgid "Product removed from your wishlist."
msgstr "Producto eliminado de tu lista de deseos."

#: app.py:344
msgid "Your session has expired. Please sign in again."
msgstr "Tu sesión ha caducado. Inicia sesión de nuevo."

